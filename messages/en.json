{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"shree": "Shree",
	"title": "Hanuman Chalisa",
	"opening_doha_title": "Opening Doha",
	"opening_doha_1": "Shri Guru Charan Saroj Raj,",
	"opening_doha_2": "Nij mane mukure sudhar |",
	"opening_doha_3": "Varnao Raghuvar Vimal Jasu,",
	"opening_doha_4": "Jo dayaku phal char ||",
	"opening_doha_5": "Budhi Hin Tanu Janike,",
	"opening_doha_6": "Sumirau Pavan Kumar |",
	"opening_doha_7": "Bal budhi Vidya dehu mohe,",
	"opening_doha_8": "Harahu Kalesa Vikar ||",
	"concluding_doha_title": "Concluding Doha",
	"concluding_doha_1": "Pavantnai sankat haran,",
	"concluding_doha_2": "Mangal murti roop |",
	"concluding_doha_3": "Ram Lakhan Sita sahit,",
	"concluding_doha_4": "Hrdaye basahu sur bhoop ||",
	"jai_shri_ram": "Jai Shri Ram",
	"verse_1_1": "Jai Hanuman gyan gun sagar,",
	"verse_1_2": "Jai Kapis tihun lok ujagar |",
	"verse_2_1": "Ram doot atulit bal dhama,",
	"verse_2_2": "Anjani-putra Pavan sut nama |",
	"verse_3_1": "Mahavir Vikram Bajrangi,",
	"verse_3_2": "Kumati nivar sumati Ke sangi |",
	"verse_4_1": "Kanchan varan viraj subesa,",
	"verse_4_2": "Kanan Kundal Kunchit Kesa |",
	"verse_5_1": "Hath Vajra Aur Dhuvaje Viraje,",
	"verse_5_2": "Kandhe moonj janehu sajai |",
	"verse_6_1": "Sankar suvan kesri Nandan,",
	"verse_6_2": "Tej pratap maha jag vandan |",
	"verse_7_1": "Vidyavan guni ati chatur,",
	"verse_7_2": "Ram kaj karibe ko aatur |",
	"verse_8_1": "Prabu charitra sunibe ko rasiya,",
	"verse_8_2": "Ram Lakhan Sita man Basiya |",
	"verse_9_1": "Sukshma roop dhari Siyahi dikhava,",
	"verse_9_2": "Vikat roop dhari lanka jarava |",
	"verse_10_1": "Bhima roop dhari asur sanghare,",
	"verse_10_2": "Ramachandra ke kaj sanvare |",
	"verse_11_1": "Laye Sanjivan Lakhan Jiyaye,",
	"verse_11_2": "Shri Raghuvir Harashi ur laye |",
	"verse_12_1": "Raghupati Kinhi bahut badai,",
	"verse_12_2": "Tum mam priye Bharat-hi sam bhai |",
	"verse_13_1": "Sahas badan tumharo yash gaave,",
	"verse_13_2": "Us kahi Shripati kanth lagaave |",
	"verse_14_1": "Sankadik Brahmadi Muneesa,",
	"verse_14_2": "Narad Sarad sahit Aheesa |",
	"verse_15_1": "Yam Kuber Digpal Jahan te,",
	"verse_15_2": "Kavi kovid kahi sake kahan te |",
	"verse_16_1": "Tum upkar Sugreevahin keenha,",
	"verse_16_2": "Ram milaye rajpad deenha |",
	"verse_17_1": "Tumharo mantra Vibheeshan mana,",
	"verse_17_2": "Lankeshwar Bhaye Sub jag jana |",
	"verse_18_1": "Yug sahastra jojan par Bhanu,",
	"verse_18_2": "Leelyo tahi madhur phal janu |",
	"verse_19_1": "Prabhu mudrika meli mukh mahee,",
	"verse_19_2": "Jaladhi langhi gaye achraj nahee |",
	"verse_20_1": "Durgaam kaj jagat ke jete,",
	"verse_20_2": "Sugam anugraha tumhre tete |",
	"verse_21_1": "Ram dware tum rakhvare,",
	"verse_21_2": "Hoat na agya binu paisare |",
	"verse_22_1": "Sub sukh lahai tumhari sarna,",
	"verse_22_2": "Tum rakshak kahu ko dar na |",
	"verse_23_1": "Aapan tej samharo aapai,",
	"verse_23_2": "Teenhon lok hank te kanpai |",
	"verse_24_1": "Bhoot pisach Nikat nahin aavai,",
	"verse_24_2": "Mahavir jab naam sunavai |",
	"verse_25_1": "Nase rog harai sab peera,",
	"verse_25_2": "Japat nirantar Hanumant beera |",
	"verse_26_1": "Sankat se Hanuman chudavai,",
	"verse_26_2": "Man Karam Vachan dyan jo lavai |",
	"verse_27_1": "Sub par Ram tapasvee raja,",
	"verse_27_2": "Tin ke kaj sakal Tum saja |",
	"verse_28_1": "Aur manorath jo koi lavai,",
	"verse_28_2": "Sohi amit jeevan phal pavai |",
	"verse_29_1": "Charon Yug partap tumhara,",
	"verse_29_2": "Hai persidh jagat ujiyara |",
	"verse_30_1": "Sadhu Sant ke tum Rakhware,",
	"verse_30_2": "Asur nikandan Ram dulhare |",
	"verse_31_1": "Ashta sidhi nav nidhi ke dhata,",
	"verse_31_2": "Us var deen Janki mata |",
	"verse_32_1": "Ram rasayan tumhare pasa,",
	"verse_32_2": "Sada raho Raghupati ke dasa |",
	"verse_33_1": "Tumhare bhajan Ram ko pavai,",
	"verse_33_2": "Janam janam ke dukh bisravai |",
	"verse_34_1": "Anth kaal Raghuvir pur jayee,",
	"verse_34_2": "Jahan janam Hari-Bakht Kahayee |",
	"verse_35_1": "Aur Devta Chit na dharehi,",
	"verse_35_2": "Hanumanth se hi sarve sukh karehi |",
	"verse_36_1": "Sankat kate mite sab peera,",
	"verse_36_2": "Jo sumirai Hanumat Balbeera |",
	"verse_37_1": "Jai Jai Jai Hanuman Gosahin,",
	"verse_37_2": "Kripa Karahu Gurudev ki nyahin |",
	"verse_38_1": "Jo sat bar path kare kohi,",
	"verse_38_2": "Chutehi bandhi maha sukh hohi |",
	"verse_39_1": "Jo yah padhe Hanuman Chalisa,",
	"verse_39_2": "Hoye siddhi sakhi Gaureesa |",
	"verse_40_1": "Tulsidas sada hari chera,",
	"verse_40_2": "Keejai Das Hrdaye mein dera |",
