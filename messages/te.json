{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"shree": "శ్రీ",
	"title": "హనుమాన్ చాలీసా",
	"opening_doha_title": "దోహా",
	"opening_doha_1": "శ్రీగురు చరణ సరోజ రజ,",
	"opening_doha_2": "నిజ మను ముకుర సుధారి |",
	"opening_doha_3": "బరనౌం రఘುబర బిమల జసు,",
	"opening_doha_4": "జో దాయకు ఫల చారి ||",
	"opening_doha_5": "బుద్ధిహీన తను జానికే,",
	"opening_doha_6": "సుమిరౌ పవన-కుమార |",
	"opening_doha_7": "బల బుధి బిద్యా దేహు మోహి,",
	"opening_doha_8": "హరహు కలేస బికార ||",
	"concluding_doha_title": "దోహా",
	"concluding_doha_1": "పవనతనయ సంకట హరన,",
	"concluding_doha_2": "మంగళ మూరతి రూప |",
	"concluding_doha_3": "రామ లఖన సీతా సహిత,",
	"concluding_doha_4": "హృదయ బసహు సుర భూప ||",
	"jai_shri_ram": "జై శ్రీ రామ",
	"verse_1_1": "జయ హనుమాన జ్ఞాన గుణ సాగర |",
	"verse_1_2": "జయ కపీశ తిహుం లోక ఉజాగర ||",
	"verse_2_1": "రామ దూత అతులిత బల ధామా |",
	"verse_2_2": "అంజని-పుత్ర పవనసుత నామా ||",
	"verse_3_1": "మహాబీర బిక్రమ బజరంగీ |",
	"verse_3_2": "కుమతి నివార సుమతి కే సంగీ ||",
	"verse_4_1": "కంచన బరన బిరాజ సుబేసా |",
	"verse_4_2": "కానన కుండల కుంచిత కేశా ||",
	"verse_5_1": "హాథ బజ్ర ఔ ధ్వజా బిరాజై |",
	"verse_5_2": "కాంధే మూంజ జనేవూ సాజై ||",
	"verse_6_1": "శంకర సువన కేసరీనందన |",
	"verse_6_2": "తేజ ప్రతాప మహా జగ వందన ||",
	"verse_7_1": "విద్యావాన గునీ అతి చాతుర |",
	"verse_7_2": "రామ కాజ కరిబే కో ఆతుర ||",
	"verse_8_1": "ప్రభు చరిత్ర సునిబే కో రసియా |",
	"verse_8_2": "రామ లఖన సీతా మన బసియా ||",
	"verse_9_1": "సూక్ష్మ రూప ధరి సియహి దిఖావా |",
	"verse_9_2": "వికట రూప ధరి లంక జరావా ||",
	"verse_10_1": "భీమ రూప ధరి అసుర సంహారే |",
	"verse_10_2": "రామచంద్ర కే కాజ సంవారే ||",
	"verse_11_1": "లాయ సజీవన లఖన జియాయే |",
	"verse_11_2": "శ్రీరఘుబీర హరషి ఉర లాయే ||",
	"verse_12_1": "రఘుపతి కీన్హీ బహుత బడాయీ |",
	"verse_12_2": "తుమ మమ ప్రియ భరతహి సమ భాయీ ||",
	"verse_13_1": "సహస బదన తుమ్హరో జస గావై |",
	"verse_13_2": "అస కహి శ్రీపతి కంఠ లగావై ||",
	"verse_14_1": "సనకాదిక బ్రహ్మాది మునీశా |",
	"verse_14_2": "నారద శారద సహిత అహీశా ||",
	"verse_15_1": "జమ కుబేర దిగపాల జహాం తే |",
	"verse_15_2": "కబి కోబిద కహి సకే కహాం తే ||",
	"verse_16_1": "తుమ ఉపకార సుగ్రీవహి కీన్హా |",
	"verse_16_2": "రామ మిలాయ రాజపద దీన్హా ||",
	"verse_17_1": "తుమ్హరో మంత్ర బిభీషన మానా |",
	"verse_17_2": "లంకేశ్వర భయే సబ జగ జానా ||",
	"verse_18_1": "జుగ సహస్ర జోజన పర భానూ |",
	"verse_18_2": "లీల్యో తాహి మధుర ఫల జానూ ||",
	"verse_19_1": "ప్రభు ముద్రికా మేలి ముఖ మాహీ |",
	"verse_19_2": "జలధి లాంఘి గయే అచరజ నాహీ ||",
	"verse_20_1": "దుర్గమ కాజ జగత కే జేతే |",
	"verse_20_2": "సుగమ అనుగ్రహ తుమ్హారే తేతే ||",
	"verse_21_1": "రామ దుఆరే తుమ రఖవారే |",
	"verse_21_2": "హోత న ఆజ్ఞా బిను పైసారే ||",
	"verse_22_1": "సబ సుఖ లహై తుమ్హారీ శరణా |",
	"verse_22_2": "తుమ రక్షక కాహూ కో డర నా ||",
	"verse_23_1": "ఆపన తేజ సమ్హారో ఆపై |",
	"verse_23_2": "తీనోం లోక హాంక తే కాంపై ||",
	"verse_24_1": "భూత పిశాచ నికట నహి ఆవై |",
	"verse_24_2": "మహాబీర జబ నామ సునావై ||",
	"verse_25_1": "నాసై రోగ హరై సబ పీరా |",
	"verse_25_2": "జపత నిరంతర హనుమత బీరా ||",
	"verse_26_1": "సంకట తే హనుమాన ఛుడావై |",
	"verse_26_2": "మన క్రమ వచన ధ్యాన జో లావై ||",
	"verse_27_1": "సబ పర రామ తపస్వీ రాజా |",
	"verse_27_2": "తిన కే కాజ సకల తుమ సాజా ||",
	"verse_28_1": "ఔర మనోరథ జో కోయీ లావై |",
	"verse_28_2": "సోయి అమిత జీవన ఫల పావై ||",
	"verse_29_1": "చారోం జుగ పరతాప తుమ్హారా |",
	"verse_29_2": "హై పరసిద్ధ జగత ఉజియారా ||",
	"verse_30_1": "సాధు-సంత కే తుమ రఖవారే |",
	"verse_30_2": "అసుర నికందన రామ దులారే ||",
	"verse_31_1": "అష్ట సిద్ధి నవ నిధి కే దాతా |",
	"verse_31_2": "అస బర దీన జానకీ మాతా ||",
	"verse_32_1": "రామ రసాయన తుమ్హరే పాసా |",
	"verse_32_2": "సదా రహో రఘుపతి కే దాసా ||",
	"verse_33_1": "తుమ్హరే భజన రామ కో పావై |",
	"verse_33_2": "జనమ-జనమ కే దుఖ బిసరావై ||",
	"verse_34_1": "అంతకాల రఘుబర పుర జాయీ |",
	"verse_34_2": "జహాం జన్మ హరి-భక్త కహాయీ ||",
	"verse_35_1": "ఔర దేవతా చిత్త న ధరయీ |",
	"verse_35_2": "హనుమత సేయి సర్వ సుఖ కరయీ ||",
	"verse_36_1": "సంకట కటై మిటై సబ పీరా |",
	"verse_36_2": "జో సుమిరై హనుమత బలబీరా ||",
	"verse_37_1": "జై జై జై హనుమాన గోసాయీ |",
	"verse_37_2": "కృపా కరహు గురుదేవ కీ నాయీ ||",
	"verse_38_1": "జో శత బార పాఠ కర కోయీ |",
	"verse_38_2": "ఛూటహి బంది మహా సుఖ హోయీ ||",
	"verse_39_1": "జో యహ పఢై హనుమాన చాలీసా |",
	"verse_39_2": "హోయ సిద్ధి సాఖీ గౌరీశా ||",
	"verse_40_1": "తులసీదాస సదా హరి చేరా |",
	"verse_40_2": "కీజై నాథ హృదయ మహ డేరా ||",
