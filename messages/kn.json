{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"shree": "ಶ್ರೀ",
	"title": "ಹನುಮಾನ್ ಚಾಲೀಸಾ",
	"opening_doha_title": "ದೋಹಾ",
	"opening_doha_1": "ಶ್ರೀಗುರು ಚರಣ ಸರೋಜ ರಜ,",
	"opening_doha_2": "ನಿಜ ಮನು ಮುಕುರ ಸುಧಾರಿ |",
	"opening_doha_3": "ಬರನೌಂ ರಘುಬರ ಬಿಮಲ ಜಸು,",
	"opening_doha_4": "ಜೋ ದಾಯಕು ಫಲ ಚಾರಿ ||",
	"opening_doha_5": "ಬುದ್ಧಿಹೀನ ತನು ಜಾನಿಕೇ,",
	"opening_doha_6": "ಸುಮಿರೌ ಪವನ-ಕುಮಾರ |",
	"opening_doha_7": "ಬಲ ಬುಧಿ ಬಿದ್ಯಾ ದೇಹು ಮೋಹಿ,",
	"opening_doha_8": "ಹರಹು ಕಲೇಸ ಬಿಕಾರ ||",
	"concluding_doha_title": "ದೋಹಾ",
	"concluding_doha_1": "ಪವನತನಯ ಸಂಕಟ ಹರನ,",
	"concluding_doha_2": "ಮಂಗಳ ಮೂರತಿ ರೂಪ |",
	"concluding_doha_3": "ರಾಮ ಲಖನ ಸೀತಾ ಸಹಿತ,",
	"concluding_doha_4": "ಹೃದಯ ಬಸಹು ಸುರ ಭೂಪ ||",
	"jai_shri_ram": "ಜೈ ಶ್ರೀ ರಾಮ್",
	"verse_1_1": "ಜಯ ಹನುಮಾನ ಜ್ಞಾನ ಗುಣ ಸಾಗರ |",
	"verse_1_2": "ಜಯ ಕಪೀಶ ತಿಹುಂ ಲೋಕ ಉಜಾಗರ ||",
	"verse_2_1": "ರಾಮ ದೂತ ಅತುಲಿತ ಬಲ ಧಾಮಾ |",
	"verse_2_2": "ಅಂಜನಿ-ಪುತ್ರ ಪವನಸುತ ನಾಮಾ ||",
	"verse_3_1": "ಮಹಾಬೀರ ಬಿಕ್ರಮ ಬಜರಂಗೀ |",
	"verse_3_2": "ಕುಮತಿ ನಿವಾರ ಸುಮತಿ ಕೇ ಸಂಗೀ ||",
	"verse_4_1": "ಕಂಚನ ಬರನ ಬಿರಾಜ ಸುಬೇಸಾ |",
	"verse_4_2": "ಕಾನನ ಕುಂಡಲ ಕುಂಚಿತ ಕೇಶಾ ||",
	"verse_5_1": "ಹಾಥ ಬಜ್ರ ಔ ಧ್ವಜಾ ಬಿರಾಜೈ |",
	"verse_5_2": "ಕಾಂಧೇ ಮೂಂಜ ಜನೇವೂ ಸಾಜೈ ||",
	"verse_6_1": "ಶಂಕರ ಸುವನ ಕೇಸರೀನಂದನ |",
	"verse_6_2": "ತೇಜ ಪ್ರತಾಪ ಮಹಾ ಜಗ ವಂದನ ||",
	"verse_7_1": "ವಿದ್ಯಾವಾನ ಗುನೀ ಅತಿ ಚಾತುರ |",
	"verse_7_2": "ರಾಮ ಕಾಜ ಕರಿಬೇ ಕೋ ಆತುರ ||",
	"verse_8_1": "ಪ್ರಭು ಚರಿತ್ರ ಸುನಿಬೇ ಕೋ ರಸಿಯಾ |",
	"verse_8_2": "ರಾಮ ಲಖನ ಸೀತಾ ಮನ ಬಸಿಯಾ ||",
	"verse_9_1": "ಸೂಕ್ಷ್ಮ ರೂಪ ಧರಿ ಸಿಯಹಿ ದಿಖಾವಾ |",
	"verse_9_2": "ವಿಕಟ ರೂಪ ಧರಿ ಲಂಕ ಜರಾವಾ ||",
	"verse_10_1": "ಭೀಮ ರೂಪ ಧರಿ ಅಸುರ ಸಂಹಾರೇ |",
	"verse_10_2": "ರಾಮಚಂದ್ರ ಕೇ ಕಾಜ ಸಂವಾರೇ ||",
	"verse_11_1": "ಲಾಯ ಸಜೀವನ ಲಖನ ಜಿಯಾಯೇ |",
	"verse_11_2": "ಶ್ರೀರಘುಬೀರ ಹರಷಿ ಉರ ಲಾಯೇ ||",
	"verse_12_1": "ರಘುಪತಿ ಕೀನ್ಹೀ ಬಹುತ ಬಡಾಯೀ |",
	"verse_12_2": "ತುಮ ಮಮ ಪ್ರಿಯ ಭರತಹಿ ಸಮ ಭಾಯೀ ||",
	"verse_13_1": "ಸಹಸ ಬದನ ತುಮ್ಹರೋ ಜಸ ಗಾವೈ |",
	"verse_13_2": "ಅಸ ಕಹಿ ಶ್ರೀಪತಿ ಕಂಠ ಲಗಾವೈ ||",
	"verse_14_1": "ಸನಕಾದಿಕ ಬ್ರಹ್ಮಾದಿ ಮುನೀಶಾ |",
	"verse_14_2": "ನಾರದ ಶಾರದ ಸಹಿತ ಅಹೀಶಾ ||",
	"verse_15_1": "ಜಮ ಕುಬೇರ ದಿಗಪಾಲ ಜಹಾಂ ತೇ |",
	"verse_15_2": "ಕಬಿ ಕೋಬಿದ ಕಹಿ ಸಕೇ ಕಹಾಂ ತೇ ||",
	"verse_16_1": "ತುಮ ಉಪಕಾರ ಸುಗ್ರೀವಹಿ ಕೀನ್ಹಾ |",
	"verse_16_2": "ರಾಮ ಮಿಲಾಯ ರಾಜಪದ ದೀನ್ಹಾ ||",
	"verse_17_1": "ತುಮ್ಹರೋ ಮಂತ್ರ ಬಿಭೀಷನ ಮಾನಾ |",
	"verse_17_2": "ಲಂಕೇಶ್ವರ ಭಯೇ ಸಬ ಜಗ ಜಾನಾ ||",
	"verse_18_1": "ಜುಗ ಸಹಸ್ರ ಜೋಜನ ಪರ ಭಾನೂ |",
	"verse_18_2": "ಲೀಲ್ಯೋ ತಾಹಿ ಮಧುರ ಫಲ ಜಾನೂ ||",
	"verse_19_1": "ಪ್ರಭು ಮುದ್ರಿಕಾ ಮೇಲಿ ಮುಖ ಮಾಹೀ |",
	"verse_19_2": "ಜಲಧಿ ಲಾಂಘಿ ಗಯೇ ಅಚರಜ ನಾಹೀ ||",
	"verse_20_1": "ದುರ್ಗಮ ಕಾಜ ಜಗತ ಕೇ ಜೇತೇ |",
	"verse_20_2": "ಸುಗಮ ಅನುಗ್ರಹ ತುಮ್ಹಾರೇ ತೇತೇ ||",
	"verse_21_1": "ರಾಮ ದುಆರೇ ತುಮ ರಖವಾರೇ |",
	"verse_21_2": "ಹೋತ ನ ಆಜ್ಞಾ ಬಿನು ಪೈಸಾರೇ ||",
	"verse_22_1": "ಸಬ ಸುಖ ಲಹೈ ತುಮ್ಹಾರೀ ಶರಣಾ |",
	"verse_22_2": "ತುಮ ರಕ್ಷಕ ಕಾಹೂ ಕೋ ಡರ ನಾ ||",
	"verse_23_1": "ಆಪನ ತೇಜ ಸಮ್ಹಾರೋ ಆಪೈ |",
	"verse_23_2": "ತೀನೋಂ ಲೋಕ ಹಾಂಕ ತೇ ಕಾಂಪೈ ||",
	"verse_24_1": "ಭೂತ ಪಿಶಾಚ ನಿಕಟ ನಹಿ ಆವೈ |",
	"verse_24_2": "ಮಹಾಬೀರ ಜಬ ನಾಮ ಸುನಾವೈ ||",
	"verse_25_1": "ನಾಸೈ ರೋಗ ಹರೈ ಸಬ ಪೀರಾ |",
	"verse_25_2": "ಜಪತ ನಿರಂತರ ಹನುಮತ ಬೀರಾ ||",
	"verse_26_1": "ಸಂಕಟ ತೇ ಹನುಮಾನ ಛುಡಾವೈ |",
	"verse_26_2": "ಮನ ಕ್ರಮ ವಚನ ಧ್ಯಾನ ಜೋ ಲಾವೈ ||",
	"verse_27_1": "ಸಬ ಪರ ರಾಮ ತಪಸ್ವೀ ರಾಜಾ |",
	"verse_27_2": "ತಿನ ಕೇ ಕಾಜ ಸಕಲ ತುಮ ಸಾಜಾ ||",
	"verse_28_1": "ಔರ ಮನೋರಥ ಜೋ ಕೋಯೀ ಲಾವೈ |",
	"verse_28_2": "ಸೋಯಿ ಅಮಿತ ಜೀವನ ಫಲ ಪಾವೈ ||",
	"verse_29_1": "ಚಾರೋಂ ಜುಗ ಪರತಾಪ ತುಮ್ಹಾರಾ |",
	"verse_29_2": "ಹೈ ಪರಸಿದ್ಧ ಜಗತ ಉಜಿಯಾರಾ ||",
	"verse_30_1": "ಸಾಧು-ಸಂತ ಕೇ ತುಮ ರಖವಾರೇ |",
	"verse_30_2": "ಅಸುರ ನಿಕಂದನ ರಾಮ ದುಲಾರೇ ||",
	"verse_31_1": "ಅಷ್ಟ ಸಿದ್ಧಿ ನವ ನಿಧಿ ಕೇ ದಾತಾ |",
	"verse_31_2": "ಅಸ ಬರ ದೀನ ಜಾನಕೀ ಮಾತಾ ||",
	"verse_32_1": "ರಾಮ ರಸಾಯನ ತುಮ್ಹರೇ ಪಾಸಾ |",
	"verse_32_2": "ಸದಾ ರಹೋ ರಘುಪತಿ ಕೇ ದಾಸಾ ||",
	"verse_33_1": "ತುಮ್ಹರೇ ಭಜನ ರಾಮ ಕೋ ಪಾವೈ |",
	"verse_33_2": "ಜನಮ-ಜನಮ ಕೇ ದುಖ ಬಿಸರಾವೈ ||",
	"verse_34_1": "ಅಂತಕಾಲ ರಘುಬರ ಪುರ ಜಾಯೀ |",
	"verse_34_2": "ಜಹಾಂ ಜನ್ಮ ಹರಿ-ಭಕ್ತ ಕಹಾಯೀ ||",
	"verse_35_1": "ಔರ ದೇವತಾ ಚಿತ್ತ ನ ಧರಯೀ |",
	"verse_35_2": "ಹನುಮತ ಸೇಯಿ ಸರ್ವ ಸುಖ ಕರಯೀ ||",
	"verse_36_1": "ಸಂಕಟ ಕಟೈ ಮಿಟೈ ಸಬ ಪೀರಾ |",
	"verse_36_2": "ಜೋ ಸುಮಿರೈ ಹನುಮತ ಬಲಬೀರಾ ||",
	"verse_37_1": "ಜೈ ಜೈ ಜೈ ಹನುಮಾನ ಗೋಸಾಯೀ |",
	"verse_37_2": "ಕೃಪಾ ಕರಹು ಗುರುದೇವ ಕೀ ನಾಯೀ ||",
	"verse_38_1": "ಜೋ ಶತ ಬಾರ ಪಾಠ ಕರ ಕೋಯೀ |",
	"verse_38_2": "ಛೂಟಹಿ ಬಂದಿ ಮಹಾ ಸುಖ ಹೋಯೀ ||",
	"verse_39_1": "ಜೋ ಯಹ ಪಢೈ ಹನುಮಾನ ಚಾಲೀಸಾ |",
	"verse_39_2": "ಹೋಯ ಸಿದ್ಧಿ ಸಾಖೀ ಗೌರೀಶಾ ||",
	"verse_40_1": "ತುಲಸೀದಾಸ ಸದಾ ಹರಿ ಚೇರಾ |",
	"verse_40_2": "ಕೀಜೈ ನಾಥ ಹೃದಯ ಮಹ ಡೇರಾ ||",
