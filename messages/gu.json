	"concluding_doha_3": "રામ લખન સીતા સહિત,",
	"concluding_doha_4": "હૃદય બસહુ સુર ભૂપ ॥",
	"jai_shri_ram": "જય શ્રી રામ",
	"verse_1_1": "જય હનુમાન જ્ઞાન ગુન સાગર।",
	"verse_1_2": "જય કપીસ તિહું લોક ઉજાગર॥",
	"verse_2_1": "રામ દૂત અતુલિત બલ ધામા।",
	"verse_2_2": "અંજનિ-પુત્ર પવનસુત નામા॥",
	"verse_3_1": "મહાબીર બિક્રમ બજરંગી।",
	"verse_3_2": "કુમતિ નિવાર સુમતિ કે સંગી॥",
	"verse_4_1": "કંચન બરન બિરાજ સુબેસા।",
	"verse_4_2": "કાનન કુંડલ કુંચિત કેસા॥",
	"verse_5_1": "હાથ બજ્ર ઔ ધ્વજા બિરાજૈ।",
	"verse_5_2": "કાંધે મૂંજ જનેઊ સાજૈ॥",
	"verse_6_1": "સંકર સુવન કેસરીનંદન।",
	"verse_6_2": "તેજ પ્રતાપ મહા જગ બંદન॥",
	"verse_7_1": "વિદ્યાવાન ગુની અતિ ચાતુર।",
	"verse_7_2": "રામ કાજ કરિબે કો આતુર॥",
	"verse_8_1": "પ્રભુ ચરિત્ર સુનિબે કો રસિયા।",
	"verse_8_2": "રામ લખન સીતા મન બસિયા॥",
	"verse_9_1": "સૂક્ષ્મ રૂપ ધરિ સિયહિં દિખાવા।",
	"verse_9_2": "બિકટ રૂપ ધરિ લંક જરાવા॥",
	"verse_10_1": "ભીમ રૂપ ધરિ અસુર સંહારે।",
	"verse_10_2": "રામચંદ્ર કે કાજ સંવારે॥",
	"verse_11_1": "લાય સજીવન લખન જિયાયે।",
	"verse_11_2": "શ્રીરઘુબીર હરષિ ઉર લાયે॥",
	"verse_12_1": "રઘુપતિ કીન્હી બહુત બડાઈ।",
	"verse_12_2": "તુમ મમ પ્રિય ભરતહિ સમ ભાઈ॥",
	"verse_13_1": "સહસ બદન તુમ્હરો જસ ગાવૈં।",
	"verse_13_2": "અસ કહિ શ્રીપતિ કંઠ લગાવૈં॥",
	"verse_14_1": "સનકાદિક બ્રહ્માદિ મુનીસા।",
	"verse_14_2": "નારદ સારદ સહિત અહીસા॥",
	"verse_15_1": "જમ કુબેર દિગપાલ જહાં તે।",
	"verse_15_2": "કબિ કોબિદ કહિ સકે કહાં તે॥",
	"verse_16_1": "તુમ ઉપકાર સુગ્રીવહિં કીન્હા।",
	"verse_16_2": "રામ મિલાય રાજ પદ દીન્હા॥",
	"verse_17_1": "તુમ્હરો મંત્ર બિભીષન માના।",
	"verse_17_2": "લંકેસ્વર ભએ સબ જગ જાના॥",
	"verse_18_1": "જુગ સહસ્ર જોજન પર ભાનૂ।",
	"verse_18_2": "લીલ્યો તાહિ મધુર ફલ જાનૂ॥",
	"verse_19_1": "પ્રભુ મુદ્રિકા મેલિ મુખ માહીં।",
	"verse_19_2": "જલધિ લાંઘિ ગયે અચરજ નાહીં॥",
	"verse_20_1": "દુર્ગમ કાજ જગત કે જેતે।",
	"verse_20_2": "સુગમ અનુગ્રહ તુમ્હરે તેતે॥",
	"verse_21_1": "રામ દુઆરે તુમ રખવારે।",
	"verse_21_2": "હોત ન આજ્ઞા બિનુ પૈસારે॥",
	"verse_22_1": "સબ સુખ લહહિં તુમ્હારી સરના।",
	"verse_22_2": "તુમ રચ્છક કાહૂ કો ડર ના॥",
	"verse_23_1": "આપન તેજ સમ્હારો આપૈ।",
	"verse_23_2": "તીનોં લોક હાંક તેં કાંપૈ॥",
	"verse_24_1": "ભૂત પિસાચ નિકટ નહિં આવૈ।",
	"verse_24_2": "મહાબીર જબ નામ સુનાવૈ॥",
	"verse_25_1": "નાસૈ રોગ હરૈ સબ પીરા।",
	"verse_25_2": "જપત નિરંતર હનુમત બીરા॥",
	"verse_26_1": "સંકટ તેં હનુમાન છુડાવૈ।",
	"verse_26_2": "મન ક્રમ બચન ધ્યાન જો લાવૈ॥",
	"verse_27_1": "સબ પર રામ તપસ્વી રાજા।",
	"verse_27_2": "તિન કે કાજ સકલ તુમ સાજા॥",
	"verse_28_1": "ઔર મનોરથ જો કોઈ લાવૈ।",
	"verse_28_2": "સોઇ અમિત જીવન ફલ પાવૈ॥",
	"verse_29_1": "ચારોં જુગ પરતાપ તુમ્હારા।",
	"verse_29_2": "હૈ પરસિદ્ધ જગત ઉજિયારા॥",
	"verse_30_1": "સાધુ-સંત કે તુમ રખવારે।",
	"verse_30_2": "અસુર નિકંદન રામ દુલારે॥",
	"verse_31_1": "અષ્ટ સિદ્ધિ નૌ નિધિ કે દાતા।",
	"verse_31_2": "અસ બર દીન જાનકી માતા॥",
	"verse_32_1": "રામ રસાયન તુમ્હરે પાસા।",
	"verse_32_2": "સદા રહો રઘુપતિ કે દાસા॥",
	"verse_33_1": "તુમ્હરે ભજન રામ કો પાવૈ।",
	"verse_33_2": "જનમ-જનમ કે દુખ બિસરાવૈ॥",
	"verse_34_1": "અન્તકાલ રઘુબર પુર જાઈ।",
	"verse_34_2": "જહાં જન્મ હરિ-ભક્ત કહાઈ॥",
	"verse_35_1": "ઔર દેવતા ચિત્ત ન ધરઈ।",
	"verse_35_2": "હનુમત સેઇ સર્બ સુખ કરઈ॥",
	"verse_36_1": "સંકટ કટૈ મિટૈ સબ પીરા।",
	"verse_36_2": "જો સુમિરૈ હનુમત બલબીરા॥",
	"verse_37_1": "જૈ જૈ જૈ હનુમાન ગોસાઈં।",
	"verse_37_2": "કૃપા કરહુ ગુરુદેવ કી નાઈં॥",
	"verse_38_1": "જો સત બાર પાઠ કર કોઈ।",
	"verse_38_2": "છૂટહિ બંદિ મહા સુખ હોઈ॥",
	"verse_39_1": "જો યહ પઢૈ હનુમાન ચાલીસા।",
	"verse_39_2": "હોય સિદ્ધિ સાખી ગૌરીસા॥",
	"verse_40_1": "તુલસીદાસ સદા હરિ ચેરા।",
	"verse_40_2": "કીજૈ નાથ હૃદય મહઁ ડેરા॥",
