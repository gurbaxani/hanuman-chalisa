{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"shree": "श्री",
	"title": "हनुमान चालीसा",
	"opening_doha_title": "दोहा",
	"opening_doha_1": "श्रीगुरु चरन सरोज रज,",
	"opening_doha_2": "निज मनु मुकुरु सुधारि ।",
	"opening_doha_3": "बरनउँ रघुबर बिमल जसु,",
	"opening_doha_4": "जो दायकु फल चारि ॥",
	"opening_doha_5": "बुद्धिहीन तनु जानिके,",
	"opening_doha_6": "सुमिरौ पवन-कुमार ।",
	"opening_doha_7": "बल बुधि बिद्या देहु मोहिं,",
	"opening_doha_8": "हरहु कलेस बिकार ॥",
	"concluding_doha_title": "दोहा",
	"concluding_doha_1": "पवनतनय संकट हरन,",
	"concluding_doha_2": "मंगल मूरति रूप ।",
	"concluding_doha_3": "राम लखन सीता सहित,",
	"concluding_doha_4": "हृदय बसहु सुर भूप ॥",
	"jai_shri_ram": "जय श्री राम",
	"verse_1_1": "जय हनुमान ज्ञान गुन सागर।",
	"verse_1_2": "जय कपीस तिहुं लोक उजागर॥",
	"verse_2_1": "राम दूत अतुलित बल धामा।",
	"verse_2_2": "अंजनि-पुत्र पवनसुत नामा॥",
	"verse_3_1": "महाबीर बिक्रम बजरंगी।",
	"verse_3_2": "कुमति निवार सुमति के संगी॥",
	"verse_4_1": "कंचन बरन बिराज सुबेसा।",
	"verse_4_2": "कानन कुंडल कुंचित केसा॥",
	"verse_5_1": "हाथ बज्र औ ध्वजा बिराजै।",
	"verse_5_2": "काँधे मूँज जनेऊ साजै॥",
	"verse_6_1": "संकर सुवन केसरीनंदन।",
	"verse_6_2": "तेज प्रताप महा जग बंदन॥",
	"verse_7_1": "विद्यावान गुनी अति चातुर।",
	"verse_7_2": "राम काज करिबे को आतुर॥",
	"verse_8_1": "प्रभु चरित्र सुनिबे को रसिया।",
	"verse_8_2": "राम लखन सीता मन बसिया॥",
	"verse_9_1": "सूक्ष्म रूप धरि सियहिं दिखावा।",
	"verse_9_2": "बिकट रूप धरि लंक जरावा॥",
	"verse_10_1": "भीम रूप धरि असुर संहारे।",
	"verse_10_2": "रामचंद्र के काज संवारे॥",
	"verse_11_1": "लाय सजीवन लखन जियाये।",
	"verse_11_2": "श्रीरघुबीर हरषि उर लाये॥",
	"verse_12_1": "रघुपति कीन्ही बहुत बड़ाई।",
	"verse_12_2": "तुम मम प्रिय भरतहि सम भाई॥",
	"verse_13_1": "सहस बदन तुम्हरो जस गावैं।",
	"verse_13_2": "अस कहि श्रीपति कंठ लगावैं॥",
	"verse_14_1": "सनकादिक ब्रह्मादि मुनीसा।",
	"verse_14_2": "नारद सारद सहित अहीसा॥",
	"verse_15_1": "जम कुबेर दिगपाल जहाँ ते।",
	"verse_15_2": "कबि कोबिद कहि सके कहाँ ते॥",
	"verse_16_1": "तुम उपकार सुग्रीवहिं कीन्हा।",
	"verse_16_2": "राम मिलाय राज पद दीन्हा॥",
	"verse_17_1": "तुम्हरो मंत्र बिभीषन माना।",
	"verse_17_2": "लंकेस्वर भए सब जग जाना॥",
	"verse_18_1": "जुग सहस्र जोजन पर भानू।",
	"verse_18_2": "लील्यो ताहि मधुर फल जानू॥",
	"verse_19_1": "प्रभु मुद्रिका मेलि मुख माहीं।",
	"verse_19_2": "जलधि लांघि गये अचरज नाहीं॥",
	"verse_20_1": "दुर्गम काज जगत के जेते।",
	"verse_20_2": "सुगम अनुग्रह तुम्हरे तेते॥",
	"verse_21_1": "राम दुआरे तुम रखवारे।",
	"verse_21_2": "होत न आज्ञा बिनु पैसारे॥",
	"verse_22_1": "सब सुख लहहिं तुम्हारी सरना।",
	"verse_22_2": "तुम रच्छक काहू को डर ना॥",
	"verse_23_1": "आपन तेज सम्हारो आपै।",
	"verse_23_2": "तीनों लोक हाँक तें कांपै॥",
	"verse_24_1": "भूत पिसाच निकट नहिं आवै।",
	"verse_24_2": "महाबीर जब नाम सुनावै॥",
	"verse_25_1": "नासै रोग हरै सब पीरा।",
	"verse_25_2": "जपत निरंतर हनुमत बीरा॥",
	"verse_26_1": "संकट तें हनुमान छुड़ावै।",
	"verse_26_2": "मन क्रम बचन ध्यान जो लावै॥",
	"verse_27_1": "सब पर राम तपस्वी राजा।",
	"verse_27_2": "तिन के काज सकल तुम साजा॥",
	"verse_28_1": "और मनोरथ जो कोई लावै।",
	"verse_28_2": "सोइ अमित जीवन फल पावै॥",
	"verse_29_1": "चारों जुग परताप तुम्हारा।",
	"verse_29_2": "है परसिद्ध जगत उजियारा॥",
	"verse_30_1": "साधु-संत के तुम रखवारे।",
	"verse_30_2": "असुर निकंदन राम दुलारे॥",
	"verse_31_1": "अष्ट सिद्धि नौ निधि के दाता।",
	"verse_31_2": "अस बर दीन जानकी माता॥",
	"verse_32_1": "राम रसायन तुम्हरे पासा।",
	"verse_32_2": "सदा रहो रघुपति के दासा॥",
	"verse_33_1": "तुम्हरे भजन राम को पावै।",
	"verse_33_2": "जनम-जनम के दुख बिसरावै॥",
	"verse_34_1": "अन्तकाल रघुबर पुर जाई।",
	"verse_34_2": "जहाँ जन्म हरि-भक्त कहाई॥",
	"verse_35_1": "और देवता चित्त न धरई।",
	"verse_35_2": "हनुमत सेइ सर्ब सुख करई॥",
	"verse_36_1": "संकट कटै मिटै सब पीरा।",
	"verse_36_2": "जो सुमिरै हनुमत बलबीरा॥",
	"verse_37_1": "जै जै जै हनुमान गोसाईं।",
	"verse_37_2": "कृपा करहु गुरुदेव की नाईं॥",
	"verse_38_1": "जो सत बार पाठ कर कोई।",
	"verse_38_2": "छूटहि बंदि महा सुख होई॥",
	"verse_39_1": "जो यह पढ़ै हनुमान चालीसा।",
	"verse_39_2": "होय सिद्धि साखी गौरीसा॥",
	"verse_40_1": "तुलसीदास सदा हरि चेरा।",
	"verse_40_2": "कीजै नाथ हृदय महँ डेरा॥",
	"hello_world": "Hello, {name} from mr!",
	"read": "वाचा",
	"learn": "शिका",
	"settings": "सेटिंग्ज"
}
