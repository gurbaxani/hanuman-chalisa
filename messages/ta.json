{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"shree": "ஸ்ரீ",
	"title": "ஹனுமான் சாலிசா",
	"opening_doha_title": "தோஹா",
	"opening_doha_1": "ஸ்ரீகுரு சரண ஸரோஜ ரஜ,",
	"opening_doha_2": "நிஜ மநு முகுர ஸுதாரி |",
	"opening_doha_3": "பரநௌம் ரகுபர விமல ஜஸு,",
	"opening_doha_4": "ஜோ தாயகு பல சாரி ||",
	"opening_doha_5": "புத்திஹீந தநு ஜாநிகே,",
	"opening_doha_6": "ஸுமிரௌ பவந-குமார |",
	"opening_doha_7": "பல புத்தி வித்யா தேஹு மோஹி,",
	"opening_doha_8": "ஹரஹு கலேஸ விகார ||",
	"concluding_doha_title": "தோஹா",
	"concluding_doha_1": "பவநதநய ஸங்கட ஹரந,",
	"concluding_doha_2": "மங்கள மூரதி ரூப |",
	"concluding_doha_3": "ராம லகந ஸீதா ஸஹித,",
	"concluding_doha_4": "ஹ்ருதய பஸஹு ஸுர பூப ||",
	"jai_shri_ram": "ஜெய் ஸ்ரீ ராம்",
	"verse_1_1": "ஜய ஹநுமாந ஜ்ஞாந குண ஸாகர |",
	"verse_1_2": "ஜய கபீஸ திஹும் லோக உஜாகர ||",
	"verse_2_1": "ராம தூத அதுலித பல தாமா |",
	"verse_2_2": "அஞ்ஜநி-புத்ர பவநஸுத நாமா ||",
	"verse_3_1": "மஹாபீர விக்ரம பஜரங்கீ |",
	"verse_3_2": "குமதி நிவார ஸுமதி கே ஸங்கீ ||",
	"verse_4_1": "கஞ்சந பரந விராஜ ஸுபேஸா |",
	"verse_4_2": "காநந குண்டல குஞ்சித கேஸா ||",
	"verse_5_1": "ஹாத் வஜ்ர ஔ த்வஜா விராஜை |",
	"verse_5_2": "காந்தே மூஞ்ஜ ஜநேவூ ஸாஜை ||",
	"verse_6_1": "ஸங்கர ஸுவந கேஸரீநந்தந |",
	"verse_6_2": "தேஜ ப்ரதாப மஹா ஜக வந்தந ||",
	"verse_7_1": "வித்யாவாந குநீ அதி சாதுர |",
	"verse_7_2": "ராம காஜ கரிபே கோ ஆதுர ||",
	"verse_8_1": "ப்ரபு சரித்ர ஸுநிபே கோ ரஸியா |",
	"verse_8_2": "ராம லகந ஸீதா மந பஸியா ||",
	"verse_9_1": "ஸூக்ஷ்ம ரூப தரி ஸியஹி திகாவா |",
	"verse_9_2": "விகட ரூப தரி லங்க ஜராவா ||",
	"verse_10_1": "பீம ரூப தரி அஸுர ஸம்ஹாரே |",
	"verse_10_2": "ராமசந்த்ர கே காஜ ஸம்வாரே ||",
	"verse_11_1": "லாய ஸஜீவந லகந ஜியாயே |",
	"verse_11_2": "ஸ்ரீரகுபீர ஹரஷி உர லாயே ||",
	"verse_12_1": "ரகுபதி கீந்ஹீ பஹுத படாயீ |",
	"verse_12_2": "தும மம ப்ரிய பரதஹி ஸம பாயீ ||",
	"verse_13_1": "ஸஹஸ பதந தும்ஹரோ ஜஸ காவை |",
	"verse_13_2": "அஸ கஹி ஸ்ரீபதி கண்ட லஹாவை ||",
	"verse_14_1": "ஸநகா திக ப்ரஹ்மாதி முநீஸா |",
	"verse_14_2": "நாரத ஸாரத ஸஹித அஹீஸா ||",
	"verse_15_1": "ஜம குபேர திகபால ஜஹாம் தே |",
	"verse_15_2": "கபி கோபித கஹி ஸகே கஹாம் தே ||",
	"verse_16_1": "தும உபகார ஸுக்ரீவஹி கீந்ஹா |",
	"verse_16_2": "ராம மிலாய ராஜபத தீந்ஹா ||",
	"verse_17_1": "தும்ஹரோ மந்த்ர விபீஷந மாநா |",
	"verse_17_2": "லங்கேஸ்வர பயே ஸப ஜக ஜாநா ||",
	"verse_18_1": "ஜுக ஸஹஸ்ர ஜோஜந பர பாநூ |",
	"verse_18_2": "லீல்யோ தாஹி மதுர பல ஜாநூ ||",
	"verse_19_1": "ப்ரபு முத்ரிகா மேலி முக மாஹீ |",
	"verse_19_2": "ஜலதி லாங்கி கயே அசரஜ நாஹீ ||",
	"verse_20_1": "துர்கம காஜ ஜகத கே ஜேதே |",
	"verse_20_2": "ஸுகம அநுக்ரஹ தும்ஹாரே தேதே ||",
	"verse_21_1": "ராம துஆரே தும ரகவாரே |",
	"verse_21_2": "ஹோத ந ஆஜ்ஞா பிநு பைஸாரே ||",
	"verse_22_1": "ஸப ஸுக லஹை தும்ஹாரீ ஸரணா |",
	"verse_22_2": "தும ரக்ஷக காஹூ கோ டர நா ||",
	"verse_23_1": "ஆபந தேஜ ஸம்ஹாரோ ஆபை |",
	"verse_23_2": "தீநோம் லோக ஹாங் தே காம்பை ||",
	"verse_24_1": "பூத பிஸாச நிகட நஹி ஆவை |",
	"verse_24_2": "மஹாபீர ஜப நாம ஸுநாவை ||",
	"verse_25_1": "நாஸை ரோக ஹரை ஸப பீரா |",
	"verse_25_2": "ஜபத நிரந்தர ஹநுமத பீரா ||",
	"verse_26_1": "ஸங்கட தே ஹநுமாந சுடாவை |",
	"verse_26_2": "மந க்ரம வசந த்யாந ஜோ லாவை ||",
	"verse_27_1": "ஸப பர ராம தபஸ்வீ ராஜா |",
	"verse_27_2": "திந கே காஜ ஸகல தும ஸாஜா ||",
	"verse_28_1": "ஔர மநோரத ஜோ கோயீ லாவை |",
	"verse_28_2": "ஸோயி அமித ஜீவந பல பாவை ||",
	"verse_29_1": "சாரோம ஜுக பரதாப தும்ஹாரா |",
	"verse_29_2": "ஹை பரஸித் ஜகத உஜியாரா ||",
	"verse_30_1": "ஸாது-ஸந்த கே தும ரகவாரே |",
	"verse_30_2": "அஸுர நிகந்தந ராம துலாரே ||",
	"verse_31_1": "அஷ்ட ஸித்தி நவ நிதி கே தாதா |",
	"verse_31_2": "அஸ பர தீந ஜாநகீ மாதா ||",
	"verse_32_1": "ராம ரஸாயந தும்ஹரே பாஸா |",
	"verse_32_2": "ஸதா ரஹோ ரகுபதி கே தாஸா ||",
	"verse_33_1": "தும்ஹரே பஜந ராம கோ பாவை |",
	"verse_33_2": "ஜநம-ஜநம கே துக பிஸராவை ||",
	"verse_34_1": "அந்தகால ரகுபர புர ஜாயீ |",
	"verse_34_2": "ஜஹாம் ஜந்ம ஹரி-பக்த கஹாயீ ||",
	"verse_35_1": "ஔர தேவதா சித்த ந தரயீ |",
	"verse_35_2": "ஹநுமத ஸேயி ஸர்வ ஸுக கரயீ ||",
	"verse_36_1": "ஸங்கட கடை மிடை ஸப பீரா |",
	"verse_36_2": "ஜோ ஸுமிரை ஹநுமத பலபீரா ||",
	"verse_37_1": "ஜை ஜை ஜை ஹநுமாந கோஸாயீ |",
	"verse_37_2": "க்ருபா கரஹு குருதேவ கீ நாயீ ||",
	"verse_38_1": "ஜோ ஸத பார பாட கர கோயீ |",
	"verse_38_2": "சூடஹி பந்தி மஹா ஸுக ஹோயீ ||",
	"verse_39_1": "ஜோ யஹ பட்டை ஹநுமாந சாலீஸா |",
	"verse_39_2": "ஹோய ஸித்தி ஸாகீ கௌரீஸா ||",
	"verse_40_1": "துளஸீதாஸ ஸதா ஹரி சேரா |",
	"verse_40_2": "கீஜை நாத ஹ்ருதய மஹ டேரா ||",
