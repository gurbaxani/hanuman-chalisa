# --- DEPENDENCIES ---
**/node_modules
.pnp
.pnp.js

# --- SVELTEKIT & BUILD OUTPUTS ---
**/.svelte-kit
**/build
**/dist
.output
.vercel
.netlify
.wrangler

# --- RUST & TAURI ---
src-tauri/target/
src-tauri/gen/
**/*.rs.bk

# --- ANDROID SPECIFIC (Very Important) ---
**/gen/android/.gradle/
**/gen/android/build/
**/gen/android/.cxx/
**/gen/android/local.properties
**/gen/android/*.iml

# --- SENSITIVE SIGNING FILES (DO NOT REMOVE) ---
# These protect your app's identity and security
*.keystore
*.jks
keystore.properties

# --- ENVIRONMENT & SECRETS ---
.env
.env.*
!.env.example
!.env.test

# --- VITE & I18N (Paraglide/Inlang) ---
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
src/lib/paraglide
project.inlang/cache/

# --- PACKAGE MANAGER SAFETY ---
# You are using pnpm; ignore other lockfiles to prevent mixups
package-lock.json
yarn.lock

# --- LOGS & DEBUGGING ---
logs
*.log
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDEs & EDITORS ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- SYSTEM FILES ---
.DS_Store
Thumbs.db
.fuse_hidden*
.directory
.Trash-*

# --- TESTING ---
/coverage
/.nyc_output
/test-results